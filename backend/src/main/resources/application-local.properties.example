# Copy this file to application-local.properties (gitignored) and supply local values.
# NEVER commit application-local.properties to Git.

# Local XAMPP MariaDB / MySQL 8 connection
spring.datasource.url=jdbc:mysql://localhost:3306/carebridge?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=

# Minimum 32-character cryptographically random secret (e.g., Base64 or hex)
carebridge.jwt.secret=REPLACE_WITH_AT_LEAST_32_CHARACTER_RANDOM_SECRET_KEY
carebridge.jwt.expiration-ms=86400000

# Protected initial Admin account bootstrap (runs once idempotently on startup)
carebridge.admin.bootstrap.enabled=true
carebridge.admin.bootstrap.full-name=CareBridge Admin
carebridge.admin.bootstrap.mobile-number=01700000000
carebridge.admin.bootstrap.password=REPLACE_WITH_STRONG_ADMIN_PASSWORD
carebridge.admin.bootstrap.address=Dhaka, Bangladesh
